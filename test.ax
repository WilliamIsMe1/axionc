// Control statements
// If statement
if (condition) {
	statement
}


// IfElse statement
if (condition) {
	statement
} else {
	statement
}

// IfElifElse statement
if (condition) {g
	statement
} else if (condition) {
	statement
} else {
	statement
}

// For loop
for (initialization statement; continuation condition; iteration statement) {
	statement
}

// ForEach loop
for (type v in array) {
	statement
}

// While loop
while (condition) {
	statement
}

// DoWhile loop
do {
	statement
} while (condition)

// Switch statement
switch (expression that returns primitive) {
	case expression:
		statement
		break
	case expression:
		statement
	default:
		statement
}

// Try statement
try {
	statement
}

// TryCatch statement
try {
	statement
} catch (Exception e) {
	statement
} // Other catch statements too

// TryCatchFinally statement
try {
	statement
} catch (Exception | Throwable e) {
	statement
} finally {
	statement
}

// TryWithResources (you get it)
try (Stream resource = new Stream()) {
	statement
} catch (Exception | Throwable e) { // Optional
	statement
} finally { // Optional
	statement
}

// Functions

type NameOfFunction(type param1, type param2=default_val, type params...) {
	statement
	return (type) value
}

//
// Data structures
//

// Class declaration

public class ClassName extends Object { // [public|protected|private] (sealed|final|nonsealed|abstract) class ClassName (extends BaseClassName) (implements Interface1, Interface2) (permits ClassName2)
	(fields|methods|blocks)
}

// field
private type Value = expression

// block
{ // Can also be static {
	statement
}

// method
public type NameOfFunction(type param1, type param2=default_val, type params...) {
	statement
	return (type) value
}

// constructor
public type(type param1, type param2=default_val, type params...) {
	statement // examples being this(param1, param2, 20) or this.param1 = param1
}

// Interface declaration
public interface Cloneable {
	methods // ie. public Object clone(); or public default Object clone() { return this.clone() }
}

// Enum declaration
public enum EnumName {
	CASE1 // Separated by newlines
	CASE2
	CASE3
	CASE4
	CASE5
	// Like java, you can instantiate multiple things
}